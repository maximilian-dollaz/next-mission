{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "mpp:validate": "mppx validate http://localhost:4242",
    "mpp:profile": "node --env-file-if-exists=.env --import tsx scripts/stripe-profile.ts",
    "mpp:deposit": "node --env-file-if-exists=.env --import tsx scripts/tempo-deposit-address.ts",
    "db:push": "supabase db push",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "deploy": "vercel deploy --prod --yes",
    "deploy:env": "node --env-file-if-exists=.env --import tsx scripts/push-vercel-env.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:4242",
    "brain:demo": "node --env-file-if-exists=.env --import tsx src/brain/cli.ts",
    "brain:status": "node --env-file-if-exists=.env --import tsx scripts/brain-status.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/genai": "^1.30.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/supabase-js": "^2.58.0",
    "agentphone": "^1.0.0",
    "hono": "^4.9.0",
    "mppx": "^0.9.2",
    "stripe": "^19.1.0",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vercel": "^62.2.0"
  }
}
